# Copy to .env.local for local work; set the same variables on the host for production.
# Never commit a real .env file. Only variables prefixed NEXT_PUBLIC_ reach the browser,
# and they are baked into the bundle at `next build` — set them before building.

# The public origin of the site, without a trailing slash. Used for canonical URLs,
# Open Graph tags, JSON-LD, sitemap.xml and robots.txt. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- End-to-end tests (optional) ---
# Run the Playwright suite against an already-deployed site instead of a local build.
# E2E_BASE_URL=https://staging.example.com
# Port for the local production server the suite starts (default 3200).
# E2E_PORT=3200

# --- Online checkout (not in use) ---
# Reserved for when online payment is switched on — see docs/COMMERCE.md.
# These are server-only secrets: never prefix them with NEXT_PUBLIC_.
# PAYSTACK_SECRET_KEY=
# DATABASE_URL=
